<%
  badge_class = {
    "queued"  => "bg-light text-dark border",
    "running" => "bg-info text-dark",
    "passed"  => "bg-success",
    "failed"  => "bg-danger",
    "error"   => "bg-danger"
  }.fetch(run&.status.to_s, "bg-light text-muted border")
%>
<span id="<%= test_studio_badge_id(path) %>" class="badge <%= badge_class %>">
  <%= run ? t("test_studio.status_#{run.status}") : t("test_studio.never_run") %>
</span>
