<div class="chat-compose" id="chatComposeForm" style="position:relative;">
  <%= form_with url: chat_room_chat_messages_path(chat_room),
                method: :post, html: { multipart: true },
                data: { action: "submit->chat#afterSubmit" } do |f| %>
    <div class="chat-emoji-picker d-none" data-chat-target="emojiPicker">
      <% %w[😀 😂 😊 😍 🎉 👍 👎 🙏 🔥 ❤️ 😢 😮 🤔 👏 🚀 ✅ ❌ 💡 📌 👀].each do |emoji| %>
        <button type="button" class="chat-emoji-option" data-action="click->chat#insertEmoji"><%= emoji %></button>
      <% end %>
    </div>
    <div class="chat-compose-box p-3 mb-3">
      <textarea
        name="chat_message[body]"
        placeholder="<%= t('chat.message_placeholder', room: chat_room.name) %>"
        rows="2"
        data-chat-target="textarea"
        data-action="input->chat#autoGrow keydown->chat#keySubmit"
        style="min-height:52px;"
      ></textarea>
      <div class="chat-compose-footer">
        <label class="btn btn-sm btn-outline-secondary mb-0" title="<%= t('chat.attach_files') %>">
          📎
          <span class="d-none d-md-inline"><%= t("chat.attach") %></span>
          <%= file_field_tag "chat_message[files][]", multiple: true, class: "d-none" %>
        </label>
        <button type="button" class="btn btn-sm btn-outline-secondary mb-0 ms-1" title="<%= t('chat.emoji') %>" data-action="click->chat#toggleEmojiPicker">
          🙂
        </button>
        <span class="compose-hints ms-2">
          <kbd>⌘↵</kbd>
          <%= t("chat.to_send") %>
        </span>
        <%= f.submit t("chat.send"), class: "btn btn-primary btn-sm ms-auto" %>
      </div>
    </div>
  <% end %>
</div>
